TODOIST_TOKEN=your_todoist_api_token_here
# Optional: pin to a specific project. Leave empty to use the Inbox.
TODOIST_PROJECT_ID=
# Optional: Todoist project ID for the shopping list (Einkaufsliste). If unset, project is looked up by name.
TODOIST_SHOPPING_PROJECT_ID=
# Language for natural language due date parsing (default: de)
TODOIST_DUE_LANG=de
# Optional: fallback due date when none is found in the text (e.g. "heute")
TODOIST_DEFAULT_DUE=
# Google AI Studio API key for Gemini Flash emoji enrichment (get free key at aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
# Gemini model name (default: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite
